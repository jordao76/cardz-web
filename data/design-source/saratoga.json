      "to": ["hidden-2", "hidden-3", "hidden-4", "hidden-5", "hidden-6", "hidden-7"], "faceUp": 1,
      "roundRobin": true },
    { "kind": "dealGroup", "to": "tab-2", "faceUp": 1 },
    { "kind": "dealGroup", "to": ["hidden-3", "hidden-4", "hidden-5", "hidden-6", "hidden-7"],
