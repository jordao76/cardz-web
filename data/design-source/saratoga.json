  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "properties": { "under": "first(h in hidden, index(h) == index(it))" },
  "scoring": {
    "value": "max(0, 10 * sum(Foundation, count(it)) + 5 * (21 - sum(hidden, count(it))) - 100 * recycles)"
