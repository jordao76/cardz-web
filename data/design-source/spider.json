{
  "name": "Spider (1 Suit)",
  "family": "Spider",
  "description": "**Goal:** assemble eight complete King-to-Ace runs and move them to the foundations.\n\n- Tableau columns build **down in any suit**. Spider has 1, 2, or 4-suit variations; this table enforces the **1-suit variation** (suits are interchangeable, so any descending run can be moved together).\n- Only **face-up** cards can be picked up; uncovering a face-down card flips it.\n- Any card may start an empty column.\n- When you're stuck, **tap the stock** to deal one card onto every column — allowed only when **no column is empty**.\n- A **complete King-to-Ace run** (all 13 cards) leaves for a foundation **on its own** the moment you finish it — there is nothing to drag.",
  "decks": [{ "suits": ["Spades"], "count": 8 }],
  "depots": [
    { "type": "Stock", "col": 0, "row": 0, "name": "stock", "acceptRule": "none",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 2, "row": 0, "name": "found", "repeat": 8,
      "acceptRule": {
        "emptyOnly": true,
        "minCount": 13,
        "seed": "King",
        "build": { "direction": "Down" }
      },
      "ejectRule": "locked" },
    { "type": "Tableau", "col": 0, "row": 1, "name": "tab", "repeat": 10,
      "acceptRule": { "build": { "direction": "Down" } },
      "ejectRule": {
        "gate": "FaceUp",
        "unit": { "kind": "Run", "build": { "direction": "Down" } }
      },
      "autoFlipTop": true, "autoSend": "Foundation" }
  ],
  "dealRules": [
    { "kind": "dealGroup",
      "to": ["tab-1", "tab-2", "tab-3", "tab-4", "tab-5", "tab-6", "tab-7", "tab-8", "tab-9",
        "tab-10"],
      "faceDown": 4, "roundRobin": true },
    { "kind": "dealGroup", "to": ["tab-1", "tab-2", "tab-3", "tab-4"], "faceDown": 1,
      "roundRobin": true },
    { "kind": "dealGroup",
      "to": ["tab-1", "tab-2", "tab-3", "tab-4", "tab-5", "tab-6", "tab-7", "tab-8", "tab-9",
        "tab-10"],
      "faceUp": 1, "roundRobin": true }
  ],
  "redealRules": [
    { "kind": "dealGroup",
      "to": ["tab-1", "tab-2", "tab-3", "tab-4", "tab-5", "tab-6", "tab-7", "tab-8", "tab-9",
        "tab-10"],
      "faceUp": 1, "roundRobin": true }
  ],
  "redealWhen": { "kind": "depotsNonEmpty", "depots": "Tableau" },
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "tools": "None"
}
