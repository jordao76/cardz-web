{
  "name": "Aces and Kings",
  "description": "**Goal:** move both decks to eight foundations. Four build **up from Ace to King** and four build **down from King to Ace**; suits do not matter.\n\n- Two reserves hold thirteen face-up cards each. Only their top cards are available.\n- Four single-card feeder spaces begin occupied and refill automatically from the stock whenever cleared.\n- Play reserve or feeder cards to either kind of foundation. A foundation top may also move to another compatible foundation.\n- There is no waste and no redeal.",
  "decks": [{ "count": 2 }],
  "depots": [
    { "type": "Foundation", "col": 2, "row": 0, "name": "up", "repeat": 4,
      "acceptRule": { "seed": "Ace", "build": { "direction": "Up" } }, "ejectRule": "topOnly" },
    { "type": "Foundation", "col": 2, "row": 1, "name": "down", "repeat": 4,
      "acceptRule": { "seed": "King", "build": { "direction": "Down" } }, "ejectRule": "topOnly" },
    { "type": "Reserve", "col": 0, "row": 0, "name": "reserve-1", "acceptRule": "none",
      "ejectRule": "topOnly" },
    { "type": "Reserve", "col": 7, "row": 0, "name": "reserve-2", "acceptRule": "none",
      "ejectRule": "topOnly" },
    { "type": "Stock", "col": 0, "row": 2.25, "name": "stock", "acceptRule": "none",
      "ejectRule": "topOnly", "landFace": "Down" },
    { "type": "Tableau", "fanDirection": "None", "col": 2, "row": 2.25, "name": "feeder",
      "repeat": 4, "acceptRule": { "emptyOnly": true, "single": true, "allowFaceDown": true },
      "ejectRule": "topOnly", "landFace": "Up", "autoRefill": ["stock"] }
  ],
  "dealRules": [
    { "kind": "place", "rank": "Ace", "suit": "Spades", "to": "up-1" },
    { "kind": "place", "rank": "Ace", "suit": "Hearts", "to": "up-2" },
    { "kind": "place", "rank": "Ace", "suit": "Diamonds", "to": "up-3" },
    { "kind": "place", "rank": "Ace", "suit": "Clubs", "to": "up-4" },
    { "kind": "place", "rank": "King", "suit": "Spades", "to": "down-1" },
    { "kind": "place", "rank": "King", "suit": "Hearts", "to": "down-2" },
    { "kind": "place", "rank": "King", "suit": "Diamonds", "to": "down-3" },
    { "kind": "place", "rank": "King", "suit": "Clubs", "to": "down-4" },
    { "kind": "dealGroup", "to": "reserve-1", "faceUp": 13 },
    { "kind": "dealGroup", "to": "reserve-2", "faceUp": 13 },
    { "kind": "dealGroup", "to": ["feeder-1", "feeder-2", "feeder-3", "feeder-4"], "faceUp": 1 }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "tools": "None"
}
