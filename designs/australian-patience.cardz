        "tab-1",
        "tab-2",
        "tab-3",
        "tab-4",
        "tab-5",
        "tab-6",
        "tab-7"
      ],
      "faceUp": 4,
      "roundRobin": true
    }
  ],
  "depotOnly": true,
  "winCondition": {
    "kind": "allCardsIn",
    "depots": {
