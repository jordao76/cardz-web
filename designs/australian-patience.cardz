{
  "name": "Australian Patience",
  "family": "Yukon",
  "description": "**Goal:** build the four suit foundations from Ace to King.\n\n- Start with seven columns of four face-up cards. Columns build **down in the same suit**.\n- Move any face-up card with all cards covering it, even if they are out of order. Only the bottom card of the group must fit.\n- Only a **King**, alone or with its covering cards, can fill an empty column.\n- Tap the stock to turn **one card** onto the waste. Only the top waste card is playable.\n- There is **one pass through the stock**: the waste cannot be recycled.",
  "depots": [
    { "type": "Stock", "col": 0, "row": 0, "name": "stock", "ejectRule": "locked",
      "landFace": "Down", "draw": { "to": "waste" } },
    { "type": "Waste", "col": 1, "row": 0, "name": "waste", "acceptRule": "none",
      "ejectRule": "topOnly" },
    { "type": "Foundation", "col": 3, "row": 0, "name": "found", "repeat": 4,
      "acceptRule": {
        "single": true,
        "seed": "Ace",
        "build": { "direction": "Up" },
        "suit": "Same"
      },
      "ejectRule": "locked" },
    { "type": "Tableau", "col": 0, "row": 1, "name": "tab", "repeat": 7,
      "acceptRule": { "seed": "King", "build": { "direction": "Down" }, "suit": "Same" },
      "ejectRule": { "gate": "FaceUp", "unit": "any" }, "autoFlipTop": true }
  ],
  "dealRules": [
    { "kind": "dealGroup", "to": ["tab-1", "tab-2", "tab-3", "tab-4", "tab-5", "tab-6", "tab-7"],
      "faceUp": 4, "roundRobin": true }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "tools": "None"
}
