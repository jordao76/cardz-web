      "acceptRule": {
        "single": true,
        "seed": "Ace",
        "build": {},
        "suit": "Same"
      },
      "ejectRule": {
        "gate": "Locked"
      }
    },
    {
      "type": "Tableau",
      "fanDirection": "Down",
      "col": 0,
      "row": 1,
      "name": "tab-1",
      "acceptRule": {
        "seed": "King",
        "build": {
          "direction": "Down"
        },
        "suit": "Same"
      },
      "ejectRule": {
        "gate": "FaceUp",
        "unit": {}
      },
      "autoFlipTop": true
    },
    {
