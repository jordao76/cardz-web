{
  "name": "Baker's Game",
  "family": "FreeCell",
  "description": "**Goal:** build all four foundations up from Ace to King, each in a single suit.\n\n- Tableau columns build **down in the same suit** (e.g. a 6 of spades on a 7 of spades).\n- You move strictly **one card at a time**. A run already in same-suit order can be dragged as a group, but only as many cards as you could move by hand: **(1 + free cells) × 2 for each empty column**.\n- Each of the four **free cells** holds a single card — use them as temporary parking.\n- Any card may start an empty column.",
  "decks": [{}],
  "depots": [
    { "type": "Cell", "col": 0, "row": 0, "name": "cell", "repeat": 4,
      "acceptRule": { "emptyOnly": true, "single": true } },
    { "type": "Foundation", "col": 4, "row": 0, "name": "found", "repeat": 4,
      "acceptRule": { "seed": "Ace", "build": { "direction": "Up" }, "suit": "Same" },
      "ejectRule": "locked" },
    { "type": "Stock", "col": -1, "row": -1, "name": "stock", "offTable": true },
    { "type": "Tableau", "col": 0, "row": 1, "name": "tab", "repeat": 8,
      "acceptRule": { "build": { "direction": "Down" }, "suit": "Same" }, "ejectRule": "faceUp" }
  ],
  "dealRules": [
    { "kind": "dealGroup",
      "to": ["tab-1", "tab-2", "tab-3", "tab-4", "tab-5", "tab-6", "tab-7", "tab-8"], "faceUp": 6,
      "roundRobin": true },
    { "kind": "dealGroup", "to": ["tab-1", "tab-2", "tab-3", "tab-4"], "faceUp": 1,
      "roundRobin": true }
  ],
  "depotOnly": true,
  "compoundMoves": "Staged",
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "tools": "None"
}
