{
  "name": "Braid",
  "aliases": ["Der Zopf", "Plait", "Pigtail", "Herringbone"],
  "description": "**Goal:** build both decks onto eight foundations, **up in suit** from a base rank the deal sets, turning the corner from King to Ace.\n\n- The first card turned from the stock starts a foundation, and its rank is the base of all eight: with an 8, every foundation starts on an 8 and ends on a 7. Each card of that rank starts an empty foundation.\n- **The braid** of twenty cards runs down the middle, never two of the same card. Only its end card is available, and only to a foundation.\n- **The four corners** play to the foundations. A space there is refilled at once from the braid's end.\n- **The eight sides** play to the foundations. A space there takes the top waste card, whenever you choose.\n- Turn the stock one card at a time to the waste; the top waste card is available. You may **redeal twice** (three passes in all).\n- The braid must be used up to win. Your **score** is the number of cards on the foundations, 104 for a win.",
  "decks": [{ "count": 2 }],
  "rules": {
    "foundation": {
      "single": true,
      "seedFrom": "bottom(west).rank",
      "build": { "direction": "Up", "wrap": true },
      "suit": "Same",
      "when": "count(depot) < 13",
      "reason": "A foundation holds thirteen cards"
    },
    "cell": { "emptyOnly": true, "single": true, "acceptFrom": ["waste"] },
    "reserve": { "emptyOnly": true, "single": true, "acceptFrom": "Tableau" }
  },
  "depots": [
    { "type": "Foundation", "col": 0, "row": 0, "name": "west", "repeat": 4, "perRow": 1,
      "acceptRule": "$foundation", "ejectRule": "locked" },
    { "type": "Foundation", "col": 7, "row": 0, "name": "east", "repeat": 4, "perRow": 1,
      "acceptRule": "$foundation", "ejectRule": "locked" },
    { "type": "Cell", "col": 1.2, "row": 0, "name": "west-side", "repeat": 4, "perRow": 1,
      "acceptRule": "$cell", "ejectRule": "topOnly", "angle": 1.5707963267948966 },
    { "type": "Cell", "col": 5.8, "row": 0, "name": "east-side", "repeat": 4, "perRow": 1,
      "acceptRule": "$cell", "ejectRule": "topOnly", "angle": 1.5707963267948966 },
    { "type": "Tableau", "col": 3.3462, "row": 0.097, "name": "braid-1", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": -0.5235987755982988, "uncoveredBy": "braid-2" },
    { "type": "Tableau", "col": 3.6538, "row": 0.2537, "name": "braid-2", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": 0.5235987755982988, "uncoveredBy": "braid-3" },
    { "type": "Tableau", "col": 3.3462, "row": 0.4104, "name": "braid-3", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": -0.5235987755982988, "uncoveredBy": "braid-4" },
    { "type": "Tableau", "col": 3.6538, "row": 0.5672, "name": "braid-4", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": 0.5235987755982988, "uncoveredBy": "braid-5" },
    { "type": "Tableau", "col": 3.3462, "row": 0.7239, "name": "braid-5", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": -0.5235987755982988, "uncoveredBy": "braid-6" },
    { "type": "Tableau", "col": 3.6538, "row": 0.8806, "name": "braid-6", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": 0.5235987755982988, "uncoveredBy": "braid-7" },
    { "type": "Tableau", "col": 3.3462, "row": 1.0373, "name": "braid-7", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": -0.5235987755982988, "uncoveredBy": "braid-8" },
    { "type": "Tableau", "col": 3.6538, "row": 1.194, "name": "braid-8", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": 0.5235987755982988, "uncoveredBy": "braid-9" },
    { "type": "Tableau", "col": 3.3462, "row": 1.3507, "name": "braid-9", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": -0.5235987755982988, "uncoveredBy": "braid-10" },
    { "type": "Tableau", "col": 3.6538, "row": 1.5075, "name": "braid-10", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": 0.5235987755982988, "uncoveredBy": "braid-11" },
    { "type": "Tableau", "col": 3.3462, "row": 1.6642, "name": "braid-11", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": -0.5235987755982988, "uncoveredBy": "braid-12" },
    { "type": "Tableau", "col": 3.6538, "row": 1.8209, "name": "braid-12", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": 0.5235987755982988, "uncoveredBy": "braid-13" },
    { "type": "Tableau", "col": 3.3462, "row": 1.9776, "name": "braid-13", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": -0.5235987755982988, "uncoveredBy": "braid-14" },
    { "type": "Tableau", "col": 3.6538, "row": 2.1343, "name": "braid-14", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": 0.5235987755982988, "uncoveredBy": "braid-15" },
    { "type": "Tableau", "col": 3.3462, "row": 2.291, "name": "braid-15", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": -0.5235987755982988, "uncoveredBy": "braid-16" },
    { "type": "Tableau", "col": 3.6538, "row": 2.4478, "name": "braid-16", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": 0.5235987755982988, "uncoveredBy": "braid-17" },
    { "type": "Tableau", "col": 3.3462, "row": 2.6045, "name": "braid-17", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": -0.5235987755982988, "uncoveredBy": "braid-18" },
    { "type": "Tableau", "col": 3.6538, "row": 2.7612, "name": "braid-18", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": 0.5235987755982988, "uncoveredBy": "braid-19" },
    { "type": "Tableau", "col": 3.3462, "row": 2.9179, "name": "braid-19", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": -0.5235987755982988, "uncoveredBy": "braid-20" },
    { "type": "Tableau", "col": 3.6538, "row": 3.0746, "name": "braid-20", "acceptRule": "none",
      "ejectRule": "topOnly", "angle": 0.5235987755982988 },
    { "type": "Reserve", "col": 2.25, "row": 0, "name": "corner-nw", "acceptRule": "$reserve",
      "ejectRule": "topOnly", "autoRefill": "Tableau" },
    { "type": "Reserve", "col": 4.75, "row": 0, "name": "corner-ne", "acceptRule": "$reserve",
      "ejectRule": "topOnly", "autoRefill": "Tableau" },
    { "type": "Reserve", "col": 2.25, "row": 3, "name": "corner-sw", "acceptRule": "$reserve",
      "ejectRule": "topOnly", "autoRefill": "Tableau" },
    { "type": "Reserve", "col": 4.75, "row": 3, "name": "corner-se", "acceptRule": "$reserve",
      "ejectRule": "topOnly", "autoRefill": "Tableau" },
    { "type": "Stock", "col": 2.25, "row": 4, "name": "stock", "acceptRule": "none",
      "ejectRule": "topOnly", "landFace": "Down",
      "draw": { "to": "waste", "recycle": true, "maxRecycles": 2 } },
    { "type": "Waste", "col": 4.75, "row": 4, "name": "waste", "acceptRule": "none",
      "ejectRule": "topOnly" }
  ],
  "dealRules": [
    { "kind": "each", "depots": "braid",
      "do": [
        { "kind": "place", "to": "@self",
          "when": "!any(d in braid, !empty(d) && top(d).rank == card.rank && top(d).suit == card.suit)" }
      ] },
    { "kind": "dealGroup", "to": ["corner-nw", "corner-ne", "corner-sw", "corner-se"],
      "faceUp": 1 },
    { "kind": "dealGroup", "to": "west-side", "faceUp": 1 },
    { "kind": "dealGroup", "to": "east-side", "faceUp": 1 },
    { "kind": "dealGroup", "to": "west-1", "faceUp": 1 }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "lossCondition": { "kind": "noLegalMoves" },
  "scoring": { "value": "sum(Foundation, count(it))", "keep": "Over" },
  "planner": { "value": "100 * sum(Foundation, count(it)) - sum(Tableau, count(it))" },
  "tools": "None"
}
