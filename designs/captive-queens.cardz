{
  "name": "Captive Queens",
  "aliases": ["Quadrille"],
  "description": "A game of pure luck. **Goal:** build the other 40 cards round the four **Queens**, who hold court in the middle and never move.\n\n- The four **Fives** and four **Sixes** are laid round the court to start eight foundations.\n- Each **Five** builds **down in suit** through the Ace to the King: 5 4 3 2 A K.\n- Each **Six** builds **up in suit** to the Jack: 6 7 8 9 10 J.\n- **Tap the stock** to turn one card at a time onto the waste. The top card of the waste is available.\n- When the stock is spent, tap it to turn the waste back over. You may do so **twice** (three passes in all).\n- Your **score** is the number of cards round the court, the Queens, Fives and Sixes among them, 52 for a win.",
  "rules": {
    "five": { "seedNone": true, "build": { "direction": "Down", "wrap": true }, "suit": "Same" },
    "six": { "seedNone": true, "build": { "direction": "Up" }, "suit": "Same" }
  },
  "depots": [
    { "type": "Stock", "col": 0, "row": 1.2313, "name": "stock", "acceptRule": "none",
      "ejectRule": "topOnly", "landFace": "Down",
      "draw": { "to": "waste", "recycle": true, "maxRecycles": 2 } },
    { "type": "Waste", "col": 0, "row": 2.2761, "name": "waste", "acceptRule": "none",
      "ejectRule": "topOnly" },
