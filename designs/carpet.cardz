{
  "name": "Carpet",
  "description": "**Goal:** move every card to the four foundations, building **up by suit from Ace to King**.\n\n- Twenty face-up cards form the **carpet**. Any carpet card may move to a foundation.\n- A hole in the carpet may be filled only with the **top waste card**; choosing when and where to fill holes is the heart of the game.\n- Draw the stock one card at a time to the waste. There is **no recycle**.\n- The foundations begin with the four Aces.\n- Your **score** is the number of cards on the foundations, 52 for a win.",
  "rules": { "tableau": { "emptyOnly": true, "single": true, "acceptFrom": ["waste"] } },
  "depots": [
    { "type": "Foundation", "col": 2, "row": 0, "name": "found", "repeat": 4,
      "acceptRule": { "seed": "Ace", "build": { "direction": "Up" }, "suit": "Same" },
      "ejectRule": "locked" },
    { "type": "Stock", "col": 7, "row": 0, "name": "stock", "acceptRule": "none",
      "ejectRule": "locked", "landFace": "Down", "draw": { "to": "waste" } },
    { "type": "Waste", "col": 8, "row": 0, "name": "waste", "acceptRule": "none",
      "ejectRule": "topOnly" },
    { "type": "Tableau", "fanDirection": "None", "col": 0, "row": 1, "name": "carpet-a",
      "repeat": 10, "acceptRule": "$tableau", "ejectRule": "topOnly" },
    { "type": "Tableau", "fanDirection": "None", "col": 0, "row": 2.15, "name": "carpet-b",
      "repeat": 10, "acceptRule": "$tableau", "ejectRule": "topOnly" }
  ],
  "dealRules": [
    { "kind": "place", "rank": "Ace", "suit": "Spades", "to": "found-1" },
    { "kind": "place", "rank": "Ace", "suit": "Hearts", "to": "found-2" },
    { "kind": "place", "rank": "Ace", "suit": "Diamonds", "to": "found-3" },
    { "kind": "place", "rank": "Ace", "suit": "Clubs", "to": "found-4" },
    { "kind": "dealGroup", "to": ["carpet-a", "carpet-b"], "faceUp": 1 }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "lossCondition": { "kind": "noLegalMoves" },
  "scoring": { "value": "sum(Foundation, count(it))", "keep": "Over" },
  "tools": "None"
}
