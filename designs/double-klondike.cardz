{
  "name": "Double Klondike",
  "family": "Klondike",
  "description": "**Goal:** build all eight foundations up from Ace to King, each in a single suit.\n\n- Two decks are shuffled together, so every card appears **twice** and each suit has two foundations.\n- Tableau columns build **down in alternating colour** (e.g. a red 6 on a black 7). Move a single card or a valid run.\n- Only **face-up** cards can be picked up; uncovering a face-down card flips it.\n- An empty column can be started with a **King** (or a run headed by a King).\n- Draw from the **stock** to the waste one card at a time; recycle the waste back to the stock when it runs out.",
  "decks": [{ "count": 2 }],
  "depots": [
    { "type": "Stock", "col": 0, "row": 0, "name": "stock", "ejectRule": "locked",
      "landFace": "Down", "draw": { "to": "waste", "recycle": true } },
    { "type": "Waste", "col": 1, "row": 0, "name": "waste", "acceptRule": "none",
      "ejectRule": "topOnly" },
    { "type": "Foundation", "col": 2, "row": 0, "name": "found", "repeat": 8,
      "acceptRule": { "seed": "Ace", "build": {}, "suit": "Same" }, "ejectRule": "locked" },
    { "type": "Tableau", "col": 0, "row": 1, "name": "tab", "repeat": 9,
      "acceptRule": { "seed": "King", "build": { "direction": "Down" }, "suit": "AlternateColor" },
      "ejectRule": "faceUp", "autoFlipTop": true }
  ],
  "dealRules": [
    { "kind": "dealGroup", "to": "tab-1", "faceUp": 1 },
    { "kind": "dealGroup",
      "to": ["tab-2", "tab-3", "tab-4", "tab-5", "tab-6", "tab-7", "tab-8", "tab-9"], "faceDown": 1,
      "roundRobin": true },
    { "kind": "dealGroup", "to": "tab-2", "faceUp": 1 },
    { "kind": "dealGroup", "to": ["tab-3", "tab-4", "tab-5", "tab-6", "tab-7", "tab-8", "tab-9"],
      "faceDown": 1, "roundRobin": true },
    { "kind": "dealGroup", "to": "tab-3", "faceUp": 1 },
    { "kind": "dealGroup", "to": ["tab-4", "tab-5", "tab-6", "tab-7", "tab-8", "tab-9"],
      "faceDown": 1, "roundRobin": true },
    { "kind": "dealGroup", "to": "tab-4", "faceUp": 1 },
    { "kind": "dealGroup", "to": ["tab-5", "tab-6", "tab-7", "tab-8", "tab-9"], "faceDown": 1,
      "roundRobin": true },
    { "kind": "dealGroup", "to": "tab-5", "faceUp": 1 },
    { "kind": "dealGroup", "to": ["tab-6", "tab-7", "tab-8", "tab-9"], "faceDown": 1,
      "roundRobin": true },
    { "kind": "dealGroup", "to": "tab-6", "faceUp": 1 },
    { "kind": "dealGroup", "to": ["tab-7", "tab-8", "tab-9"], "faceDown": 1, "roundRobin": true },
    { "kind": "dealGroup", "to": "tab-7", "faceUp": 1 },
    { "kind": "dealGroup", "to": ["tab-8", "tab-9"], "faceDown": 1, "roundRobin": true },
    { "kind": "dealGroup", "to": "tab-8", "faceUp": 1 },
    { "kind": "dealGroup", "to": "tab-9", "faceDown": 1 },
    { "kind": "dealGroup", "to": "tab-9", "faceUp": 1 }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "tools": "None"
}
