{
  "name": "Faerie Queen",
  "aliases": ["Spenser's Fairie Queen", "Fairie Queen"],
  "description": "**Goal:** build the eight foundations from Ace up to Queen, 96 cards. The eight Kings stay on the table.\n\n- A King starts the first column. **Tap the stock** to turn the next card: a **King starts a new column**, an **Ace** goes to a foundation, and any other card is dealt onto the **newest King's column**.\n- Each foundation builds **up in suit** from its Ace to the Queen.\n- Only the **card at the foot** of each column is available. It may go to a foundation, or onto another column's foot **one rank higher, regardless of suit**: a 7 on an 8.\n- A **King alone** in its column takes any available card.\n- You may play at any time, during the deal or after it. There is no redeal.\n- Your **score** is the number of cards on the foundations, 96 for a win.",
  "decks": [{ "count": 2 }],
  "depots": [
    { "type": "Stock", "col": 0, "row": 0, "name": "stock", "acceptRule": "none",
      "ejectRule": "locked", "draw": { "to": "hold" } },
    { "type": "Waste", "col": 0, "row": 1, "name": "hold", "acceptRule": "none",
      "ejectRule": "locked",
      "triggers": [
        { "when": "!empty(depot)",
          "do": [
            { "kind": "move", "from": "@self",
              "to": "if(top(depot).rank == Ace, first(Foundation, empty(it)), if(top(depot).rank == King, first(column, empty(it)), last(column, !empty(it))))" }
          ] }
      ] },
    { "type": "Tableau", "col": 1.25, "row": 0, "name": "column", "repeat": 8,
      "acceptRule": {
        "single": true,
        "seedNone": true,
        "when": "card.rank != King && (count(depot) == 1 || card.value + 1 == top.value)",
        "reason": "Build down by one, or onto a King alone"
      },
      "ejectRule": "topOnly" },
    { "type": "Foundation", "col": 9.5, "row": 0, "name": "foundation", "repeat": 8, "perRow": 2,
      "acceptRule": {
        "single": true,
        "seed": "Ace",
        "build": { "direction": "Up" },
        "suit": "Same",
        "when": "card.rank != King",
        "reason": "A foundation ends on its Queen"
      },
      "ejectRule": "locked" }
  ],
  "dealRules": [{ "kind": "place", "rank": "King", "suit": "Spades", "to": "column-1" }],
  "depotOnly": true,
  "winCondition": { "kind": "expr", "when": "sum(Foundation, count(it)) == 96" },
  "lossCondition": { "kind": "noLegalMoves" },
  "scoring": { "value": "sum(Foundation, count(it))", "keep": "Over" },
  "planner": { "value": "100 * sum(Foundation, count(it)) - count(stock)" },
  "tools": "None"
}
