{
  "name": "Fourteen Out",
  "family": "Pyramid",
  "description": "**Goal:** remove all 52 cards in pairs that total **14**.\n\n- All cards are dealt **face up** into twelve columns; the first four columns hold five cards and the other eight hold four.\n- Only the **top card** of each column is available.\n- Drag an available card **onto its partner**, the top card of another column, and both go to the **discard**: Ace + King, 2 + Queen, 3 + Jack, 4 + 10, 5 + 9, 6 + 8, or 7 + 7.\n- The game is lost when no pair is left.\n- Your **score** is the number of cards removed, 52 for a win.",
  "depots": [
    { "type": "Stock", "col": -1, "row": -1, "name": "stock", "offTable": true },
    { "type": "Tableau", "col": 0, "row": 0, "name": "column", "repeat": 12,
      "acceptRule": {
        "single": true,
        "when": "!empty(depot) && card.value + top.value == 14",
        "reason": "Pair cards that total 14"
      },
      "ejectRule": "topOnly",
      "triggers": [
        { "when": "any(d in Tableau, d == cameFrom(depot))",
          "do": [{ "kind": "move", "from": "@self", "to": "discard", "count": "2" }] }
      ] },
    { "type": "Foundation", "col": 5.5, "row": 2.6, "name": "discard", "acceptRule": "none",
      "ejectRule": "locked", "landFace": "Down" }
  ],
  "dealRules": [
    { "kind": "dealGroup", "to": "column", "faceUp": 4, "roundRobin": true },
    { "kind": "dealGroup", "to": ["column-1", "column-2", "column-3", "column-4"], "faceUp": 1,
      "roundRobin": true }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "depotsEmpty", "depots": "Tableau" },
  "lossCondition": { "kind": "noLegalMoves" },
  "scoring": { "value": "count(discard)", "keep": "Over" },
  "planner": true,
  "aids": { "pairSum": 14 },
  "tools": "None"
}
