{
  "name": "Gaps",
  "family": "Gaps",
  "aliases": ["Montana", "Rangoon", "Spaces", "Addiction"],
  "description": "**Goal:** order each row from **Two to King** in one suit.\n\n- The Aces are taken away, leaving four gaps.\n- Fill a gap with the card **one higher, in the same suit**, as the card on its left. A gap in the **first column** takes any **Two**.\n- A gap to the right of a King, or of another gap, stays empty.\n- **Stuck?** Tap the stock to redeal, **twice** at most. Each row keeps its run from a Two in the first column; the other cards are shuffled and dealt again, leaving one gap after each run.",
  "depots": [
    { "type": "Tableau", "fanDirection": "None", "col": 0, "row": 0, "name": "cell", "repeat": 52,
      "perRow": 13,
      "acceptRule": {
        "emptyOnly": true,
        "single": true,
        "when": "let left = top(depot.left); depot.column == 0 && card.rank == Two || depot.column > 0 && card.suit == left.suit && card.value == left.value + 1",
        "reason": "Play the next card up in the suit on the left"
      },
      "ejectRule": "topOnly" },
    { "type": "Stock", "col": 0, "row": 4, "name": "stock", "acceptRule": "none",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 1, "row": 4, "name": "aces", "acceptRule": "none",
      "ejectRule": "locked" }
  ],
  "dealRules": [
    { "kind": "dealGroup", "to": "cell", "faceUp": 1 },
    { "kind": "gather", "from": ["cell"], "to": "aces", "when": "top(depot).rank == Ace" }
  ],
  "redealRules": [
    { "kind": "gather", "from": ["cell"], "to": "stock", "when": "!depot.inPlace" },
    { "kind": "shuffle", "depot": "stock" },
    { "kind": "dealGroup", "to": "cell", "faceUp": 1, "from": "stock",
      "when": "empty(depot) && depot.column != 0 && empty(depot.left)" }
  ],
  "maxRedeals": 2,
  "depotOnly": true,
  "winCondition": { "kind": "expr", "when": "all(d in cell, d.column == 12 || d.fits)" },
  "lossCondition": { "kind": "noLegalMoves" },
  "properties": {
    "column": "(index(it) - 1) % 13",
    "left": "neighbour(it, 0 - 1)",
    "lead": "neighbour(it, 0 - it.column)",
    "fits": "top(it).value == it.column + 2 && top(it).suit == top(it.lead).suit",
    "follows": "let left = top(it.left); it.column == 0 && top(it).rank == Two || it.column > 0 && top(it).suit == left.suit && top(it).value == left.value + 1",
    "inPlace": "all(k in cell, index(k) < index(it.lead) || index(k) > index(it) || k.fits)"
  },
  "scoring": { "value": "count(d in cell, d.inPlace)", "keep": "Over" },
  "planner": {
    "value": "100 * count(d in cell, d.inPlace) + 10 * sum(d in cell, count(e in d, d.follows) * (15 - top(d).value)) - 5 * count(d in cell, empty(d) && d.column > 0 && top(d.left).rank == King)"
  },
  "tools": "None"
}
