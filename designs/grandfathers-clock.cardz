{
  "name": "Grandfather's Clock",
  "description": "**Goal:** complete the clock. Each of its twelve foundations builds **up in suit** until its top card shows the hour it stands at: Jack for eleven, Queen for twelve, Ace for one.\n\n- The twelve starting cards are set out before the deal: 9♣ at twelve o'clock, then clockwise 10♥ J♠ Q♦ K♣ 2♥ 3♠ 4♦ 5♣ 6♥ 7♠ 8♦. Ranks wrap from King to Ace.\n- The other forty cards are dealt **face up** into eight columns of five, four each side of the clock.\n- Columns build **down regardless of suit**. Move one card at a time.\n- Any card may fill an empty column.",
  "rules": {
    "foundation": {
      "single": true,
      "seedNone": true,
      "build": { "direction": "Up", "wrap": true },
      "suit": "Same"
    },
    "tableau": { "build": { "direction": "Down" } }
  },
  "depots": [
    { "type": "Stock", "col": -1, "row": -1, "name": "stock", "offTable": true },
    { "type": "Foundation", "col": 7.5, "row": 0, "name": "twelve", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 9, "row": 0.375, "name": "one", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 10.1, "row": 1.4, "name": "two", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 10.5, "row": 2.8, "name": "three", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 10.1, "row": 4.2, "name": "four", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 9, "row": 5.225, "name": "five", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 7.5, "row": 5.6, "name": "six", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 6, "row": 5.225, "name": "seven", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 4.9, "row": 4.2, "name": "eight", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 4.5, "row": 2.8, "name": "nine", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 4.9, "row": 1.4, "name": "ten", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 6, "row": 0.375, "name": "eleven", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Tableau", "col": 0, "row": 0, "name": "left", "repeat": 4, "acceptRule": "$tableau",
      "ejectRule": "topOnly" },
    { "type": "Tableau", "col": 12, "row": 0, "name": "right", "repeat": 4,
      "acceptRule": "$tableau", "ejectRule": "topOnly" }
  ],
  "dealRules": [
    { "kind": "place", "rank": "Nine", "suit": "Clubs", "to": "twelve" },
    { "kind": "place", "rank": "Ten", "suit": "Hearts", "to": "one" },
    { "kind": "place", "rank": "Jack", "suit": "Spades", "to": "two" },
    { "kind": "place", "rank": "Queen", "suit": "Diamonds", "to": "three" },
    { "kind": "place", "rank": "King", "suit": "Clubs", "to": "four" },
    { "kind": "place", "rank": "Two", "suit": "Hearts", "to": "five" },
    { "kind": "place", "rank": "Three", "suit": "Spades", "to": "six" },
    { "kind": "place", "rank": "Four", "suit": "Diamonds", "to": "seven" },
    { "kind": "place", "rank": "Five", "suit": "Clubs", "to": "eight" },
    { "kind": "place", "rank": "Six", "suit": "Hearts", "to": "nine" },
    { "kind": "place", "rank": "Seven", "suit": "Spades", "to": "ten" },
    { "kind": "place", "rank": "Eight", "suit": "Diamonds", "to": "eleven" },
    { "kind": "dealGroup",
      "to": ["left-1", "left-2", "left-3", "left-4", "right-1", "right-2", "right-3", "right-4"],
      "faceUp": 5, "roundRobin": true }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "tools": "None"
}
