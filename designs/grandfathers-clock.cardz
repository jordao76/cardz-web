{
  "name": "Grandfather's Clock",
  "description": "**Goal:** complete the clock. Each of its twelve foundations builds **up in suit** until its top card shows the hour it stands at: Jack for eleven, Queen for twelve, Ace for one.\n\n- The twelve starting cards are set out before the deal: 9♣ at twelve o'clock, then clockwise 10♥ J♠ Q♦ K♣ 2♥ 3♠ 4♦ 5♣ 6♥ 7♠ 8♦. Ranks wrap from King to Ace.\n- The other forty cards are dealt **face up** into eight columns of five, four each side of the clock.\n- Columns build **down regardless of suit**. Move one card at a time.\n- Any card may fill an empty column.",
  "rules": {
    "foundation": {
      "single": true,
      "seedNone": true,
      "build": { "direction": "Up", "wrap": true },
      "suit": "Same"
    },
    "tableau": { "build": { "direction": "Down" } }
  },
  "depots": [
    { "type": "Stock", "col": -1, "row": -1, "name": "stock", "offTable": true },
    { "type": "Foundation", "col": 6.837, "row": 0, "name": "twelve", "acceptRule": "$foundation",
      "ejectRule": "locked", "angle": 3.141592653589793 },
    { "type": "Foundation", "col": 8.038, "row": 0.25, "name": "one", "acceptRule": "$foundation",
      "ejectRule": "locked", "angle": 3.6651914291880923 },
    { "type": "Foundation", "col": 8.918, "row": 0.933, "name": "two", "acceptRule": "$foundation",
      "ejectRule": "locked", "angle": 4.1887902047863905 },
    { "type": "Foundation", "col": 9.24, "row": 1.866, "name": "three",
      "acceptRule": "$foundation", "ejectRule": "locked", "angle": 4.71238898038469 },
    { "type": "Foundation", "col": 8.918, "row": 2.799, "name": "four",
      "acceptRule": "$foundation", "ejectRule": "locked", "angle": 5.235987755982989 },
    { "type": "Foundation", "col": 8.038, "row": 3.481, "name": "five",
      "acceptRule": "$foundation", "ejectRule": "locked", "angle": 5.759586531581287 },
    { "type": "Foundation", "col": 6.837, "row": 3.731, "name": "six", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 5.635, "row": 3.481, "name": "seven",
      "acceptRule": "$foundation", "ejectRule": "locked", "angle": 0.5235987755982988 },
    { "type": "Foundation", "col": 4.755, "row": 2.799, "name": "eight",
      "acceptRule": "$foundation", "ejectRule": "locked", "angle": 1.0471975511965976 },
    { "type": "Foundation", "col": 4.452, "row": 1.866, "name": "nine",
      "acceptRule": "$foundation", "ejectRule": "locked", "angle": 1.5707963267948966 },
    { "type": "Foundation", "col": 4.755, "row": 0.933, "name": "ten", "acceptRule": "$foundation",
      "ejectRule": "locked", "angle": 2.0943951023931953 },
    { "type": "Foundation", "col": 5.635, "row": 0.25, "name": "eleven",
      "acceptRule": "$foundation", "ejectRule": "locked", "angle": 2.6179938779914944 },
    { "type": "Tableau", "col": 0, "row": 0, "name": "left", "repeat": 4, "acceptRule": "$tableau",
      "ejectRule": "topOnly" },
    { "type": "Tableau", "col": 10.673, "row": 0, "name": "right", "repeat": 4,
      "acceptRule": "$tableau", "ejectRule": "topOnly" }
  ],
  "dealRules": [
    { "kind": "place", "rank": "Nine", "suit": "Clubs", "to": "twelve" },
    { "kind": "place", "rank": "Ten", "suit": "Hearts", "to": "one" },
    { "kind": "place", "rank": "Jack", "suit": "Spades", "to": "two" },
    { "kind": "place", "rank": "Queen", "suit": "Diamonds", "to": "three" },
