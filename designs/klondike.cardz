{
  "$schema": "https://cardz.roderic.dev/designs/schema.json",
  "Name": "My Klondike",
  "Description": "**Goal:** build all four foundations up from Ace to King, each in a single suit.\n\n- Tableau columns build **down in alternating colour** (e.g. a red 6 on a black 7). Move a single card or a valid run.\n- Only **face-up** cards can be picked up; uncovering a face-down card flips it.\n- An empty column can be started with a **King** (or a run headed by a King).\n- Draw from the **stock** to the waste; recycle the waste back to the stock when it runs out.",
  "Decks": [
    {}
  ],
  "Depots": [
    {
      "Type": "Stock",
      "FanDirection": "None",
      "Col": 0,
      "Row": 0,
      "Name": "stock",
      "EjectRule": {
        "Gate": "Locked"
      },
      "LandFace": "Down",
      "Draw": {
        "To": "waste",
        "Recycle": true
      }
    },
    {
      "Type": "Waste",
      "FanDirection": "None",
      "Col": 1,
      "Row": 0,
      "Name": "waste",
      "AcceptRule": {
        "RejectsAll": true
      },
      "EjectRule": {
        "Gate": "TopOnly"
      }
    },
    {
      "Type": "Foundation",
      "FanDirection": "None",
      "Col": 3,
      "Row": 0,
      "Name": "found-1",
      "AcceptRule": {
        "Seed": "Ace",
        "Build": {},
        "Suit": "Same"
      },
      "EjectRule": {
        "Gate": "Locked"
      }
    },
    {
      "Type": "Foundation",
      "FanDirection": "None",
      "Col": 4,
      "Row": 0,
      "Name": "found-2",
      "AcceptRule": {
        "Seed": "Ace",
        "Build": {},
        "Suit": "Same"
      },
      "EjectRule": {
        "Gate": "Locked"
      }
    },
    {
      "Type": "Foundation",
      "FanDirection": "None",
      "Col": 5,
      "Row": 0,
      "Name": "found-3",
      "AcceptRule": {
        "Seed": "Ace",
        "Build": {},
        "Suit": "Same"
      },
      "EjectRule": {
        "Gate": "Locked"
      }
    },
    {
      "Type": "Foundation",
      "FanDirection": "None",
      "Col": 6,
      "Row": 0,
      "Name": "found-4",
      "AcceptRule": {
        "Seed": "Ace",
        "Build": {},
        "Suit": "Same"
      },
      "EjectRule": {
        "Gate": "Locked"
      }
    },
    {
      "Type": "Tableau",
      "FanDirection": "Down",
      "Col": 0,
      "Row": 1,
      "Name": "tab-1",
      "AcceptRule": {
        "Seed": "King",
        "Build": {
          "Direction": "Down"
        },
        "Suit": "AlternateColor"
      },
      "EjectRule": {
        "Gate": "FaceUp"
      },
      "AutoFlipTop": true
    },
    {
      "Type": "Tableau",
      "FanDirection": "Down",
      "Col": 1,
      "Row": 1,
      "Name": "tab-2",
      "AcceptRule": {
