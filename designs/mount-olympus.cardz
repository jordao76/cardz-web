{
  "name": "Mount Olympus",
  "aliases": ["Der Olymp"],
  "description": "**Goal:** build both decks onto sixteen foundations. They build **up by twos, in suit**.\n\n- The eight Aces and eight Twos start the foundations, laid out as a pyramid. An Ace builds A 3 5 7 9 J K, a Two builds 2 4 6 8 10 Q, so a won game shows Kings and Queens alternating up each side.\n- **The battery** of nine piles builds **down by twos, in suit**: a 7 on a 9, a 10 on a Queen. Only the top card of each pile is available, and cards move one at a time.\n- A space in the battery is refilled at once from the waste, or from the stock while the waste is empty.\n- Turn the stock one card at a time to the waste; the top waste card is available.\n- You may **redeal once**: tap the empty stock to turn the waste back over.\n- Your **score** is the number of cards on the foundations, 104 for a win.",
  "decks": [{ "count": 2 }],
  "rules": {
    "foundation": {
      "single": true,
      "seedNone": true,
      "build": { "direction": "Up", "step": 2 },
      "suit": "Same"
    }
  },
  "depots": [
    { "type": "Foundation", "col": 7, "row": 0, "name": "ace-1", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 8, "row": 0, "name": "two-1", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 6, "row": 0.5, "name": "two-2", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 9, "row": 0.5, "name": "ace-2", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 5, "row": 1, "name": "ace-3", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 10, "row": 1, "name": "two-3", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 4, "row": 1.5, "name": "two-4", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 11, "row": 1.5, "name": "ace-4", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 3, "row": 2, "name": "ace-5", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 12, "row": 2, "name": "two-5", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 2, "row": 2.5, "name": "two-6", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 13, "row": 2.5, "name": "ace-6", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 1, "row": 3, "name": "ace-7", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 14, "row": 3, "name": "two-7", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 0, "row": 3.5, "name": "two-8", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 15, "row": 3.5, "name": "ace-8", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Waste", "col": 8.5, "row": 1.5, "name": "waste", "acceptRule": "none",
      "ejectRule": "topOnly" },
    { "type": "Stock", "col": 6.5, "row": 1.5, "name": "stock", "acceptRule": "none",
      "ejectRule": "topOnly", "landFace": "Down",
      "draw": { "to": "waste", "recycle": true, "maxRecycles": 1 } },
    { "type": "Tableau", "col": 3.5, "row": 3.1, "name": "battery", "repeat": 9,
      "acceptRule": {
        "single": true,
        "allowFaceDown": true,
        "when": "empty(depot) && (source == waste || source == stock) || !empty(depot) && card.suit == top.suit && card.value + 2 == top.value",
        "reason": "Build down by twos in suit"
      },
      "ejectRule": "topOnly", "landFace": "Up", "autoRefill": ["waste", "stock"] }
  ],
  "dealRules": [
    { "kind": "place", "rank": "Ace", "suit": "Spades", "to": "ace-1" },
    { "kind": "place", "rank": "Ace", "suit": "Spades", "to": "ace-2" },
    { "kind": "place", "rank": "Ace", "suit": "Hearts", "to": "ace-3" },
    { "kind": "place", "rank": "Ace", "suit": "Hearts", "to": "ace-4" },
    { "kind": "place", "rank": "Ace", "suit": "Clubs", "to": "ace-5" },
    { "kind": "place", "rank": "Ace", "suit": "Clubs", "to": "ace-6" },
    { "kind": "place", "rank": "Ace", "suit": "Diamonds", "to": "ace-7" },
    { "kind": "place", "rank": "Ace", "suit": "Diamonds", "to": "ace-8" },
    { "kind": "place", "rank": "Two", "suit": "Spades", "to": "two-1" },
    { "kind": "place", "rank": "Two", "suit": "Spades", "to": "two-2" },
    { "kind": "place", "rank": "Two", "suit": "Hearts", "to": "two-3" },
    { "kind": "place", "rank": "Two", "suit": "Hearts", "to": "two-4" },
    { "kind": "place", "rank": "Two", "suit": "Clubs", "to": "two-5" },
    { "kind": "place", "rank": "Two", "suit": "Clubs", "to": "two-6" },
    { "kind": "place", "rank": "Two", "suit": "Diamonds", "to": "two-7" },
    { "kind": "place", "rank": "Two", "suit": "Diamonds", "to": "two-8" },
    { "kind": "dealGroup", "to": "battery", "faceUp": 1 }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "lossCondition": { "kind": "noLegalMoves" },
  "scoring": { "value": "sum(Foundation, count(it))", "keep": "Over" },
  "tools": "None"
}
