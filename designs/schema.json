          "visibility": {
            "enum": [
              "All",
              "Owner"
            ]
          },
          "perSeat": {
            "type": "boolean"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "description": "Stamp out this many copies of the depot, one grid column apart, their names suffixed -1 to -N. Needs col/row placement."
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "dealRules": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "kind"
