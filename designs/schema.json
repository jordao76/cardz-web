              "rank": {
                "enum": [
                  "Ace",
                  "Two",
                  "Three",
                  "Four",
                  "Five",
                  "Six",
                  "Seven",
                  "Eight",
                  "Nine",
                  "Ten",
                  "Jack",
                  "Queen",
                  "King"
                ]
              },
              "suit": {
                "enum": [
                  "Clubs",
                  "Diamonds",
                  "Hearts",
                  "Spades"
                ]
              },
              "to": {
                "type": "string"
              },
              "joker": {
                "type": "boolean"
              }
            },
            "required": [
              "rank",
              "suit",
              "to"
            ]
          }
        ]
      }
