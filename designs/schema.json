                    "properties": {
                      "direction": {
                        "enum": [
                          "Up",
                          "Down",
                          "Either"
                        ]
                      },
                      "step": {
                        "type": "integer",
                        "default": 1
                      },
                      "wrap": {
                        "type": "boolean",
                        "default": false
                      },
                      "sum": {
