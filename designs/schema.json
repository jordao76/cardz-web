            "required": [
              "from",
              "to"
            ]
          },
          {
            "properties": {
              "kind": {
                "const": "flipTop"
              },
              "depot": {
                "type": "string"
              }
            },
            "required": [
              "depot"
            ]
          },
          {
            "properties": {
              "kind": {
                "const": "dealGroup"
              },
              "to": {
                "type": [
                  "array",
                  "string"
                ],
                "items": {
                  "type": "string"
                }
              },
              "faceDown": {
                "type": "integer"
              },
              "faceUp": {
                "type": "integer"
              },
              "roundRobin": {
                "type": "boolean"
