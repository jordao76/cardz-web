            "default": null
          },
          "ranks": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "enum": [
                "Ace",
                "Two",
                "Three",
                "Four",
                "Five",
                "Six",
                "Seven",
                "Eight",
                "Nine",
                "Ten",
                "Jack",
                "Queen",
                "King"
