{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardz.roderic.dev/designs/schema.json",
  "title": "Cardz design",
  "description": "A solitaire for Cardz, written as data. The reference is https://cardz.roderic.dev/make-a-game.html",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "family": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "variantAxis": {
      "type": [
        "string",
        "null"
      ]
    },
    "variantLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "variantSelections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parameterId": {
            "type": "string"
          },
          "axisLabel": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "optionLabel": {
            "type": "string"
          }
        },
        "required": [
          "parameterId",
          "axisLabel",
          "value",
          "optionLabel"
        ]
      }
