{
  "$schema": "https://cardz.roderic.dev/designs/schema.json",
  "name": "Simple Simon",
  "family": "Spider",
  "description": "**Goal:** assemble four same-suit runs from King to Ace. Completed runs move to the foundations automatically.\n\n- All 52 cards start **face up** in ten columns. There is **no stock or redeal**.\n- Build columns **down in any suit**, without wrapping from Ace to King.\n- Move one card, or a **same-suit descending sequence** as a group. Mixed-suit groups cannot move together.\n- Any card or valid sequence may fill an empty column.",
  "decks": [
    {}
  ],
  "depots": [
    {
      "type": "Stock",
      "fanDirection": "None",
      "col": -1,
      "row": -1,
      "name": "stock",
      "offTable": true
    },
    {
      "type": "Foundation",
      "fanDirection": "None",
      "col": 3,
      "row": 0,
      "name": "found-1",
      "acceptRule": {
        "emptyOnly": true,
        "minCount": 13,
        "seed": "King",
        "build": {
          "direction": "Down"
        }
      },
      "ejectRule": {
        "gate": "Locked"
      }
    },
    {
