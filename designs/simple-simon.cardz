{
  "name": "Simple Simon",
  "family": "Spider",
  "description": "**Goal:** assemble four same-suit runs from King to Ace. Completed runs move to the foundations automatically.\n\n- All 52 cards start **face up** in ten columns. There is **no stock or redeal**.\n- Build columns **down in any suit**, without wrapping from Ace to King.\n- Move one card, or a **same-suit descending sequence** as a group. Mixed-suit groups cannot move together.\n- Any card or valid sequence may fill an empty column.",
  "depots": [
    { "type": "Stock", "col": -1, "row": -1, "name": "stock", "offTable": true },
    { "type": "Foundation", "col": 3, "row": 0, "name": "found", "repeat": 4,
      "acceptRule": {
        "emptyOnly": true,
        "minCount": 13,
        "seed": "King",
        "build": { "direction": "Down" }
      },
      "ejectRule": "locked" },
    { "type": "Tableau", "col": 0, "row": 1, "name": "tab", "repeat": 10,
      "acceptRule": { "build": { "direction": "Down" } },
      "ejectRule": {
        "gate": "FaceUp",
        "unit": { "kind": "Run", "build": { "direction": "Down" }, "suit": "Same" }
      },
      "autoSend": "Foundation" }
  ],
  "dealRules": [
    { "kind": "dealGroup", "to": "tab-1", "faceUp": 8 },
    { "kind": "dealGroup", "to": "tab-2", "faceUp": 8 },
    { "kind": "dealGroup", "to": "tab-3", "faceUp": 8 },
    { "kind": "dealGroup", "to": "tab-4", "faceUp": 7 },
    { "kind": "dealGroup", "to": "tab-5", "faceUp": 6 },
    { "kind": "dealGroup", "to": "tab-6", "faceUp": 5 },
    { "kind": "dealGroup", "to": "tab-7", "faceUp": 4 },
    { "kind": "dealGroup", "to": "tab-8", "faceUp": 3 },
    { "kind": "dealGroup", "to": "tab-9", "faceUp": 2 },
    { "kind": "dealGroup", "to": "tab-10", "faceUp": 1 }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "tools": "None"
}
