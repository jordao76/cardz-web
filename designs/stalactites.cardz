{
  "name": "Stalactites",
  "description": "**Goal:** build every card onto four foundations, thirteen cards each. They build **up regardless of suit**, wrapping from King round to Ace, either **by ones** or **by twos**.\n\n- The first four cards dealt start the foundations, whatever their ranks.\n- **Your first build chooses the step** for all four foundations. On a 5, a 6 sets them building by ones (6 7 8 … K A … 4), a 7 by twos (7 9 J K 2 4 6 8 10 Q A 3).\n- The other forty-eight cards are dealt **face up** into eight columns of six.\n- **Nothing is built on the columns.** Their top cards go to a foundation or to one of the two cells, and an emptied column stays empty.\n- Each **cell** holds one card, which may go only to a foundation.\n- Your **score** is the number of cards on the foundations, 52 for a win.",
  "depots": [
    { "type": "Stock", "col": -1, "row": -1, "name": "stock", "offTable": true },
    { "type": "Cell", "col": 0, "row": 0, "name": "cell", "repeat": 2,
      "acceptRule": { "emptyOnly": true, "single": true, "acceptFrom": "Tableau" } },
    { "type": "Foundation", "col": 4, "row": 0, "name": "base", "repeat": 4,
      "acceptRule": {
        "single": true,
        "seedNone": true,
        "when": "let s = max(Foundation, it.stepTaken); let d = (card.value - top.value) % 13; count(depot) < 13 && if(s == 0, d == 1 || d == 2, d == s)",
        "reason": "Build up by the chosen step"
      },
      "ejectRule": "locked" },
    { "type": "Tableau", "col": 0, "row": 1, "name": "column", "repeat": 8, "acceptRule": "none",
      "ejectRule": "topOnly" }
  ],
  "dealRules": [
    { "kind": "dealGroup", "to": "base", "faceUp": 1 },
    { "kind": "dealGroup", "to": "column", "faceUp": 6, "roundRobin": true }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "lossCondition": { "kind": "noLegalMoves" },
  "properties": {
    "stepTaken": "if(count(it) < 2, 0, (bottom(above(it, bottom(it))).value - bottom(it).value) % 13)"
  },
  "scoring": { "value": "sum(Foundation, count(it))", "keep": "Over" },
  "planner": {
    "value": "let s = max(Foundation, it.stepTaken); 10 * sum(Foundation, count(it)) + count(c in column, !empty(c) && any(f in Foundation, count(f) < 13 && (top(c).value - top(f).value) % 13 == s)) + count(c in cell, !empty(c) && any(f in Foundation, count(f) < 13 && (top(c).value - top(f).value) % 13 == s))"
  },
  "tools": "None"
}
