{
  "name": "Sultan",
  "description": "**Goal:** surround the **Sultan** (the fixed King of Hearts) with eight completed foundations whose top cards are Queens.\n\n- Seven outer foundations begin with Kings and continue **Ace upward to Queen in suit**. The eighth begins with the Ace of Hearts and builds upward to Queen.\n- Six face-up **divan** cards are available for foundations. A cleared divan space refills automatically from the stock.\n- Draw the stock one card at a time to the waste. The waste may be recycled **twice** (three passes total).\n- The central King of Hearts never moves.",
  "decks": [{ "count": 2 }],
  "rules": {
    "foundation": { "seed": "King", "build": { "direction": "Up", "wrap": true }, "suit": "Same" },
    "tableau": { "emptyOnly": true, "single": true, "allowFaceDown": true }
  },
  "depots": [
    { "type": "Foundation", "col": 2, "row": 0, "name": "diamond-1", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 3, "row": 0, "name": "heart-ace",
      "acceptRule": { "seed": "Ace", "build": { "direction": "Up" }, "suit": "Same" },
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 4, "row": 0, "name": "diamond-2", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 2, "row": 1, "name": "spade-1", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 3, "row": 1, "name": "sultan", "acceptRule": "none",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 4, "row": 1, "name": "spade-2", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 2, "row": 2, "name": "club-1", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 3, "row": 2, "name": "heart-king", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Foundation", "col": 4, "row": 2, "name": "club-2", "acceptRule": "$foundation",
      "ejectRule": "locked" },
    { "type": "Tableau", "fanDirection": "None", "col": 0, "row": 0, "name": "divan-1",
      "acceptRule": "$tableau", "ejectRule": "topOnly", "landFace": "Up", "autoRefill": ["stock"] },
    { "type": "Tableau", "fanDirection": "None", "col": 0, "row": 1, "name": "divan-2",
      "acceptRule": "$tableau", "ejectRule": "topOnly", "landFace": "Up", "autoRefill": ["stock"] },
    { "type": "Tableau", "fanDirection": "None", "col": 0, "row": 2, "name": "divan-3",
      "acceptRule": "$tableau", "ejectRule": "topOnly", "landFace": "Up", "autoRefill": ["stock"] },
    { "type": "Tableau", "fanDirection": "None", "col": 6, "row": 0, "name": "divan-4",
      "acceptRule": "$tableau", "ejectRule": "topOnly", "landFace": "Up", "autoRefill": ["stock"] },
    { "type": "Tableau", "fanDirection": "None", "col": 6, "row": 1, "name": "divan-5",
      "acceptRule": "$tableau", "ejectRule": "topOnly", "landFace": "Up", "autoRefill": ["stock"] },
    { "type": "Tableau", "fanDirection": "None", "col": 6, "row": 2, "name": "divan-6",
      "acceptRule": "$tableau", "ejectRule": "topOnly", "landFace": "Up", "autoRefill": ["stock"] },
    { "type": "Stock", "col": 2.5, "row": 3.35, "name": "stock", "acceptRule": "none",
      "ejectRule": "topOnly", "landFace": "Down",
      "draw": { "to": "waste", "recycle": true, "maxRecycles": 2 } },
    { "type": "Waste", "col": 3.5, "row": 3.35, "name": "waste", "acceptRule": "none",
      "ejectRule": "topOnly" }
  ],
  "dealRules": [
    { "kind": "place", "rank": "King", "suit": "Diamonds", "to": "diamond-1" },
    { "kind": "place", "rank": "Ace", "suit": "Hearts", "to": "heart-ace" },
    { "kind": "place", "rank": "King", "suit": "Diamonds", "to": "diamond-2" },
    { "kind": "place", "rank": "King", "suit": "Spades", "to": "spade-1" },
    { "kind": "place", "rank": "King", "suit": "Hearts", "to": "sultan" },
    { "kind": "place", "rank": "King", "suit": "Spades", "to": "spade-2" },
    { "kind": "place", "rank": "King", "suit": "Clubs", "to": "club-1" },
    { "kind": "place", "rank": "King", "suit": "Hearts", "to": "heart-king" },
    { "kind": "place", "rank": "King", "suit": "Clubs", "to": "club-2" },
    { "kind": "dealGroup", "to": ["divan-1", "divan-2", "divan-3", "divan-4", "divan-5", "divan-6"],
      "faceUp": 1 }
  ],
  "depotOnly": true,
  "winCondition": { "kind": "allCardsIn", "depots": "Foundation" },
  "tools": "None"
}
